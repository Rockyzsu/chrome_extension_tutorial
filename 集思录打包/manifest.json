{
  "manifest_version": 3,
  "name": "集思录可转债过滤器",
  "version": "1.2",
  "description": "可转债强赎过滤",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "*://www.jisilu.cn/data/cbnew/*",
    "*://www.jisilu.cn/web/data/cb/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.jisilu.cn/data/cbnew/*", "*://www.jisilu.cn/web/data/cb/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}